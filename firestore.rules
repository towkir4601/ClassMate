rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isLoggedIn() && exists(userDocPath());
    }

    function getUser() {
      return userExists()
        ? get(userDocPath()).data
        : null;
    }

    function getRole() {
      return userExists() && "role" in getUser() && getUser().role is string ? getUser().role.lower() : "";
    }

    function isSuperAdmin() {
      return isLoggedIn() && getRole() == "superadmin";
    }

    function isAdmin() {
      return isLoggedIn() && (getRole() == "admin" || getRole() == "superadmin");
    }

    function hasPermission(permissionKey) {
      return userExists() &&
        "permissions" in getUser() &&
        getUser().permissions is map &&
        permissionKey in getUser().permissions &&
        getUser().permissions[permissionKey] == true;
    }

    function canPostNotice() {
      return isAdmin() || hasPermission("canPostNotices");
    }

    function canSendClassCancel() {
      return isAdmin() || hasPermission("canSendClassCancel");
    }

    function canEditTimetable() {
      return isAdmin() || hasPermission("canEditTimetable");
    }

    function canManageUsers() {
      return isAdmin() || hasPermission("canManageUsers");
    }

    function canManageAdmins() {
      return isSuperAdmin() || hasPermission("canManageAdmins");
    }

    function canUploadPdf() {
      return isLoggedIn();
    }

    function isStudent() {
      return isLoggedIn() && getRole() == "student";
    }

    function isTeacher() {
      return isLoggedIn() && getRole() == "teacher";
    }

    function isApprovedUser() {
      return userExists() && "approved" in getUser() && getUser().approved == true;
    }

    function noticeLikeId(noticeId) {
      return noticeId + "_" + request.auth.uid;
    }

    function commentLikeId(commentId) {
      return commentId + "_" + request.auth.uid;
    }

    function reminderId(noticeId) {
      return noticeId + "_" + request.auth.uid;
    }

    function ownUserDoc() {
      return isLoggedIn() && resource.data.userId == request.auth.uid;
    }

    function isFriendsPublic() {
      return exists(/databases/$(database)/documents/config/friends) &&
        get(/databases/$(database)/documents/config/friends).data.isPublic == true;
    }

    function validStudentIdForAuthCreate(request) {
      return !("studentId" in request.resource.data) ||
        request.resource.data.studentId == "" ||
        (
          request.resource.data.studentId is string &&
          request.resource.data.studentId.matches("^[a-zA-Z0-9]{3,50}$")
        );
    }

    function validStudentIdValue(studentId) {
      return studentId is string && studentId.matches("^[a-zA-Z0-9]{3,50}$");
    }

    function noElevatedCreatePermissions(request) {
      return !("permissions" in request.resource.data) ||
        (
          request.resource.data.permissions is map
          && request.resource.data.permissions.keys().hasOnly([
            "canCreatePolls",
            "canEditTimetable",
            "canManageAcademicCalendar",
            "canPostNotices",
            "canSendClassCancel",
            "canUploadPDF",
            "canUploadLibrary",
            "canUploadResult",
            "canUploadSeatPlan",
            "canManageUsers",
            "canManageAdmins"
          ])
          && (!("canCreatePolls" in request.resource.data.permissions) ||
              request.resource.data.permissions.canCreatePolls == false)
          && (!("canEditTimetable" in request.resource.data.permissions) ||
              request.resource.data.permissions.canEditTimetable == false)
          && (!("canManageAcademicCalendar" in request.resource.data.permissions) ||
              request.resource.data.permissions.canManageAcademicCalendar == false)
          && (!("canPostNotices" in request.resource.data.permissions) ||
              request.resource.data.permissions.canPostNotices == false)
          && (!("canUploadPDF" in request.resource.data.permissions) ||
              request.resource.data.permissions.canUploadPDF == false)
          && (!("canUploadLibrary" in request.resource.data.permissions) ||
              request.resource.data.permissions.canUploadLibrary == false)
          && (!("canSendClassCancel" in request.resource.data.permissions) ||
              request.resource.data.permissions.canSendClassCancel == false)
          && (!("canUploadSeatPlan" in request.resource.data.permissions) ||
              request.resource.data.permissions.canUploadSeatPlan == false)
          && (!("canUploadResult" in request.resource.data.permissions) ||
              request.resource.data.permissions.canUploadResult == false)
          && (!("canManageUsers" in request.resource.data.permissions) ||
              request.resource.data.permissions.canManageUsers == false)
          && (!("canManageAdmins" in request.resource.data.permissions) ||
              request.resource.data.permissions.canManageAdmins == false)
        );
    }

    function validOwnUserCreate(userId, request) {
      return isLoggedIn()
        && request.auth.uid == userId
        && (!("uid" in request.resource.data) || request.resource.data.uid == userId)
        && (!("name" in request.resource.data) ||
            (request.resource.data.name is string &&
             request.resource.data.name.size() <= 80))
        && (!("fullName" in request.resource.data) ||
            (request.resource.data.fullName is string &&
             request.resource.data.fullName.size() <= 80))
        && (!("email" in request.resource.data) ||
            (request.resource.data.email is string &&
             request.resource.data.email.size() <= 120))
        && validStudentIdForAuthCreate(request)
        && (!("department" in request.resource.data) ||
            (request.resource.data.department is string &&
             request.resource.data.department.size() <= 12))
        && (!("role" in request.resource.data) || request.resource.data.role in ["student", "teacher"])
        && (!("authProvider" in request.resource.data) ||
            request.resource.data.authProvider in ["email", "google"])
        // ── Security Invariant: users cannot self-approve or create their document as deleted ──
        && (!("approved" in request.resource.data) || request.resource.data.approved == false)
        && (!("isDeleted" in request.resource.data) || request.resource.data.isDeleted == false)
        && noElevatedCreatePermissions(request);
    }

    function permissionStaysFalseOrUnchanged(permissionKey) {
      return !(permissionKey in request.resource.data.permissions) ||
        request.resource.data.permissions[permissionKey] == false ||
        (
          "permissions" in resource.data &&
          permissionKey in resource.data.permissions &&
          resource.data.permissions[permissionKey] == true &&
          request.resource.data.permissions[permissionKey] == true
        );
    }

    function existingTruePermissionPreserved(permissionKey) {
      return !("permissions" in resource.data) ||
        !(permissionKey in resource.data.permissions) ||
        resource.data.permissions[permissionKey] != true ||
        (
          permissionKey in request.resource.data.permissions &&
          request.resource.data.permissions[permissionKey] == true
        );
    }

    function validOwnPermissionsUpdate() {
      return !("permissions" in request.resource.data.diff(resource.data).affectedKeys()) ||
        (
          request.resource.data.permissions is map
          && request.resource.data.permissions.keys().hasOnly([
            "canCreatePolls",
            "canEditTimetable",
            "canManageAcademicCalendar",
            "canPostNotices",
            "canSendClassCancel",
            "canUploadPDF",
            "canUploadLibrary",
            "canUploadResult",
            "canUploadSeatPlan",
            "canManageUsers",
            "canManageAdmins",
            "canManageClubEvents",
            "canManageLostFound"
          ])
        );
    }

    function validOwnUserUpdate(userId) {
      return isLoggedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "createdAt",
          "name",
          "fullName",
          "email",
          "photoUrl",
          "studentId",
          "batch",
          "semester",
          "teacherCode",
          "whatsappNumber",
          "presentAddress",
          "permanentAddress",
          "fatherName",
          "motherName",
          "department",
          "authProvider",
          "updatedAt",
          "phone",
          "bloodGroup",
          "homeDistrict",
          "address",
          "oneSignalPlayerId",
          "permissions",
          "isOnline",
          "role",
          "approved",
          "favoriteSubjects",
          "favoritePdfIds"
        ])
        && (!("uid" in request.resource.data) || request.resource.data.uid == userId)
        && (!("role" in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.role in ["superadmin", "admin", "teacher", "club_admin", "cr", "student"])
        && validOwnPermissionsUpdate()
        && (!("name" in request.resource.data) ||
            (request.resource.data.name is string &&
             request.resource.data.name.size() <= 80))
        && (!("fullName" in request.resource.data) ||
            (request.resource.data.fullName is string &&
             request.resource.data.fullName.size() <= 80))
        && (!("email" in request.resource.data) ||
            (request.resource.data.email is string &&
             request.resource.data.email.size() <= 120))
        && (!("studentId" in request.resource.data) ||
            request.resource.data.studentId == "" ||
            (request.resource.data.studentId is string &&
             request.resource.data.studentId.matches("^[a-zA-Z0-9]{3,50}$")))
        && (!("department" in request.resource.data) ||
            (request.resource.data.department is string &&
             request.resource.data.department.size() <= 12))
        && (!("authProvider" in request.resource.data) ||
            request.resource.data.authProvider in ["email", "google"])
        // ── Batch immutability: once batch is set, user cannot change it ──
        && (!("batch" in request.resource.data.diff(resource.data).affectedKeys()) ||
            !("batch" in resource.data) ||
            resource.data.batch == "" ||
            resource.data.batch == null)
        // ── Security Invariant: regular users cannot modify approved or isDeleted status ──
        && (!("approved" in request.resource.data.diff(resource.data).affectedKeys()))
        && (!("isDeleted" in request.resource.data.diff(resource.data).affectedKeys()))
        && validOwnPermissionsUpdate();
    }

    function validLibraryCourseType() {
      return request.resource.data.courseType in ["regular", "lab", "other"];
    }

    function validLibraryFileType() {
      return request.resource.data.fileType in [
        "pdf",
        "ppt",
        "pptx",
        "doc",
        "docx",
        "xls",
        "xlsx",
        "image",
        "zip",
        "other"
      ];
    }

    function validLibraryProvider() {
      return request.resource.data.provider in ["github_releases", "external_link", "telegram"];
    }

    function validLibraryMimeType() {
      return request.resource.data.mimeType in [
        "application/pdf",
        "application/vnd.ms-powerpoint",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "image/png",
        "image/jpeg",
        "image/jpg",
        "image/webp",
        "application/zip",
        "application/octet-stream"
      ];
    }

    function validLibraryBaseFields() {
      return request.resource.data.keys().hasOnly([
        "title",
        "subject",
        "courseCode",
        "courseType",
        "description",
        "fileType",
        "mimeType",
        "sizeBytes",
        "provider",
        "downloadUrl",
        "driveUrl",
        "telegramUrl",
        "fileId",
        "githubAssetId",
        "githubAssetName",
        "uploadedByUid",
        "uploadedByName",
        "uploadedBy",
        "createdAt",
        "updatedAt",
        "timestamp",
        "downloadCount",
        "isDeleted",
        "batch",
        "department",
        "departmentId",
        "accessScope",
        "isBatchPrivate"
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 180
      && request.resource.data.subject is string
      && request.resource.data.subject.size() > 0
      && request.resource.data.subject.size() <= 120
      && request.resource.data.courseCode is string
      && request.resource.data.courseCode.size() > 0
      && request.resource.data.courseCode.size() <= 40
      && validLibraryCourseType()
      && validLibraryFileType()
      && validLibraryMimeType()
      && validLibraryProvider()
      && request.resource.data.sizeBytes is int
      && request.resource.data.sizeBytes >= 0
      && request.resource.data.sizeBytes <= 104857600
      && request.resource.data.downloadUrl is string
      && request.resource.data.downloadUrl.size() > 0
      && request.resource.data.downloadUrl.size() <= 2000
      && request.resource.data.githubAssetId is int
      && request.resource.data.githubAssetId >= 0
      && request.resource.data.githubAssetName is string
      && request.resource.data.githubAssetName.size() <= 255
      && request.resource.data.uploadedByUid == request.auth.uid
      && request.resource.data.uploadedByName is string
      && request.resource.data.uploadedByName.size() <= 80
      && request.resource.data.uploadedBy is string
      && request.resource.data.uploadedBy.size() <= 80
      && request.resource.data.downloadCount == 0
      && request.resource.data.isDeleted == false
      && (!("batch" in request.resource.data) || (request.resource.data.batch is string && request.resource.data.batch.size() <= 50))
      && (!("department" in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 100))
      && (!("departmentId" in request.resource.data) || (request.resource.data.departmentId is string && request.resource.data.departmentId.size() <= 100))
      && (!("accessScope" in request.resource.data) || (request.resource.data.accessScope is string && request.resource.data.accessScope.size() <= 50))
      && (!("isBatchPrivate" in request.resource.data) || request.resource.data.isBatchPrivate is bool);
    }

    function validLibraryGitHubCreate() {
      return request.resource.data.provider == "github_releases"
        && request.resource.data.downloadUrl.matches("^https://github\\.com/.*/releases/download/.*$")
        && request.resource.data.githubAssetId > 0
        && request.resource.data.githubAssetName.size() > 0
        && (
          !("driveUrl" in request.resource.data) ||
          request.resource.data.driveUrl == "" ||
          request.resource.data.driveUrl == request.resource.data.downloadUrl
        );
    }

    function validLibraryExternalLinkCreate() {
      return request.resource.data.provider == "external_link"
        && request.resource.data.githubAssetId == 0
        && request.resource.data.githubAssetName == "";
    }

    function validLibraryTelegramCreate() {
      return request.resource.data.provider == "telegram"
        && request.resource.data.telegramUrl is string
        && request.resource.data.telegramUrl.size() > 0
        && request.resource.data.fileId is string
        && request.resource.data.githubAssetId == 0
        && request.resource.data.githubAssetName == "";
    }

    function validLibraryCreate() {
      return canUploadPdf()
        && request.resource.data.uploadedByUid == request.auth.uid
        && validLibraryBaseFields()
        && (
          validLibraryGitHubCreate() ||
          validLibraryExternalLinkCreate() ||
          validLibraryTelegramCreate()
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.timestamp == request.time;
    }

    function validLibraryDownloadCountUpdate() {
      return isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["downloadCount"])
        && request.resource.data.downloadCount is int
        && request.resource.data.downloadCount == resource.data.downloadCount + 1;
    }

    function validLibrarySoftDeleteUpdate() {
      return isLoggedIn()
        && (isAdmin() || resource.data.uploadedByUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isDeleted", "updatedAt"])
        && request.resource.data.isDeleted == true
        && request.resource.data.updatedAt == request.time;
    }

    function validLibraryBatchUpdate() {
      return isLoggedIn()
        && (isAdmin() || resource.data.uploadedByUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["batch", "updatedAt"])
        && request.resource.data.batch is string
        && request.resource.data.batch.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // ── Zero-Trust Batch & Department Privacy Helpers for Library ────────────

    function userMatchesDocBatch(docBatch) {
      return userExists()
        && "batch" in getUser()
        && getUser().batch is string
        && getUser().batch != ""
        && docBatch is string
        && docBatch != ""
        && (
          getUser().batch == docBatch ||
          getUser().batch.lower() == docBatch.lower() ||
          (getUser().batch == "14" && (docBatch == "2-1" || docBatch == "2_1")) ||
          (getUser().batch == "2-1" && (docBatch == "14" || docBatch == "2_1"))
        );
    }

    function userMatchesDocDepartment(docData) {
      return (
        // Case 1: doc has departmentId present and non-empty
        ("departmentId" in docData && docData.departmentId is string && docData.departmentId != "" && docData.departmentId != "all")
          ? (
              userExists() && (
                ("departmentId" in getUser() && getUser().departmentId is string && getUser().departmentId.lower() == docData.departmentId.lower()) ||
                ("department" in getUser() && getUser().department is string && getUser().department.lower() == docData.departmentId.lower()) ||
                ("department" in docData && docData.department is string && "department" in getUser() && getUser().department is string && getUser().department.lower() == docData.department.lower())
              )
            )
          // Case 2: doc has no departmentId (or empty/all), but has department present and non-empty
          : (
              ("department" in docData && docData.department is string && docData.department != "" && docData.department != "all")
                ? (
                    userExists() && (
                      ("department" in getUser() && getUser().department is string && getUser().department.lower() == docData.department.lower()) ||
                      ("departmentId" in getUser() && getUser().departmentId is string && getUser().departmentId.lower() == docData.department.lower())
                    )
                  )
                // Case 3: doc has neither departmentId nor department (or they are empty / "all")
                : true
            )
      );
    }

    function isBatchPrivateDoc(docData) {
      return ("isBatchPrivate" in docData && docData.isBatchPrivate == true) ||
             ("accessScope" in docData && docData.accessScope == "batch");
    }

    function canReadBatchPrivateLibraryFile(docData) {
      return isLoggedIn()
        && (!("isDeleted" in docData) || docData.isDeleted != true)
        && isApprovedUser()
        && "batch" in docData
        && userMatchesDocBatch(docData.batch)
        && userMatchesDocDepartment(docData);
    }

    function canReadStandardLibraryFile(docData) {
      return isLoggedIn()
        && (!("isDeleted" in docData) || docData.isDeleted != true)
        && (isApprovedUser() || isAdmin() || isTeacher())
        && (isSuperAdmin() || userMatchesDocDepartment(docData));
    }

    // ── Question Bank helpers ─────────────────────────────────────────────────

    function validQbExamType() {
      return request.resource.data.examType in [
        "Final", "CT1", "CT2", "CT3", "CT4", "Mid", "Other"
      ];
    }

    function validQbProvider() {
      return !("provider" in request.resource.data) ||
        request.resource.data.provider in [
          "github_releases", "external_link", "telegram", "github", "external", ""
        ];
    }

    function validQbUrl() {
      // At least one of downloadUrl / driveUrl / telegramUrl must be non-empty
      return (
        ("downloadUrl" in request.resource.data && request.resource.data.downloadUrl.size() > 0) ||
        ("driveUrl"    in request.resource.data && request.resource.data.driveUrl.size()    > 0) ||
        ("telegramUrl" in request.resource.data && request.resource.data.telegramUrl.size() > 0)
      );
    }

    function validQbBaseFields() {
      return request.resource.data.keys().hasOnly([
        "title",
        "courseCode",
        "subject",
        "examType",
        "semester",
        "year",
        "uploadedByUid",
        "uploadedByName",
        "uploadedBy",
        "telegramUrl",
        "driveUrl",
        "downloadUrl",
        "provider",
        "sizeBytes",
        "downloadCount",
        "timestamp",
        "createdAt",
        "updatedAt",
        "isDeleted",
        "batch",
        "fileType",
        "mimeType",
        "fileId",
        "githubAssetId",
        "githubAssetName",
        "courseType",
        "description",
        "department",
        "departmentId",
        "accessScope",
        "isBatchPrivate"
      ])
      && (!("description" in request.resource.data) || request.resource.data.description is string)
      && (!("fileType" in request.resource.data) || request.resource.data.fileType is string)
      && (!("mimeType" in request.resource.data) || request.resource.data.mimeType is string)
      && (!("fileId" in request.resource.data) || request.resource.data.fileId is string)
      && (!("githubAssetId" in request.resource.data) || request.resource.data.githubAssetId is number)
      && (!("githubAssetName" in request.resource.data) || request.resource.data.githubAssetName is string)
      && (!("courseType" in request.resource.data) || request.resource.data.courseType is string)
      && (!("department" in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 100))
      && (!("departmentId" in request.resource.data) || (request.resource.data.departmentId is string && request.resource.data.departmentId.size() <= 100))
      && (!("accessScope" in request.resource.data) || (request.resource.data.accessScope is string && request.resource.data.accessScope.size() <= 50))
      && (!("isBatchPrivate" in request.resource.data) || request.resource.data.isBatchPrivate is bool)
      && (!("batch" in request.resource.data) || (request.resource.data.batch is string && request.resource.data.batch.size() <= 50))
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 200
      && request.resource.data.courseCode is string
      && request.resource.data.courseCode.size() <= 40
      && request.resource.data.subject is string
      && request.resource.data.subject.size() <= 120
      && validQbExamType()
      && request.resource.data.semester is string
      && request.resource.data.semester.size() <= 30
      && request.resource.data.year is string
      && request.resource.data.year.size() <= 10
      && request.resource.data.year.matches("^[0-9]{4}$")
      && request.resource.data.uploadedByUid == request.auth.uid
      && request.resource.data.uploadedByName is string
      && request.resource.data.uploadedByName.size() <= 80
      && request.resource.data.uploadedBy is string
      && request.resource.data.uploadedBy.size() <= 80
      && request.resource.data.telegramUrl is string
      && request.resource.data.telegramUrl.size() <= 2000
      && request.resource.data.driveUrl is string
      && request.resource.data.driveUrl.size() <= 2000
      && request.resource.data.downloadUrl is string
      && request.resource.data.downloadUrl.size() <= 2000
      && validQbUrl()
      && validQbProvider()
      && request.resource.data.sizeBytes is int
      && request.resource.data.sizeBytes >= 0
      && request.resource.data.sizeBytes <= 104857600
      && request.resource.data.downloadCount == 0
      && request.resource.data.isDeleted == false;
    }

    function validQbCreate() {
      return canUploadPdf()
        && request.resource.data.uploadedByUid == request.auth.uid
        && validQbBaseFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.timestamp == request.time;
    }

    function validQbDownloadCountUpdate() {
      return isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["downloadCount"])
        && request.resource.data.downloadCount is int
        && request.resource.data.downloadCount == resource.data.downloadCount + 1;
    }

    function validQbSoftDelete() {
      return isLoggedIn()
        && (isAdmin() || resource.data.uploadedByUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isDeleted", "updatedAt"])
        && request.resource.data.isDeleted == true
        && request.resource.data.updatedAt == request.time;
    }

    function validResourceNoticeCreate() {
      return isLoggedIn()
        && request.resource.data.keys().hasOnly([
          "title",
          "body",
          "content",
          "type",
          "postedBy",
          "createdBy",
          "createdByName",
          "timestamp",
          "createdAt",
          "updatedAt",
          "isResource",
          "isCancel",
          "isSub",
          "isAssignment",
          "isClassTest",
          "subject",
          "pdfId",
          "isPinned",
          "isDeleted",
          "batch",
          "targetBatch",
          "department",
          "departmentId",
          "accessScope",
          "isBatchPrivate"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.isResource == true
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.pdfId is string
        && request.resource.data.pdfId.size() > 0
        && request.resource.data.timestamp == request.time;
    }

    function validClassCancelPeriodUpdate() {
      return canSendClassCancel()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isCancelled",
          "cancelDate"
        ])
        && request.resource.data.isCancelled == true
        && request.resource.data.cancelDate is string
        && request.resource.data.cancelDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    }

    function validAcademicCalendarExceptionBase() {
      return request.resource.data.keys().hasOnly([
          "title",
          "type",
          "startDate",
          "endDate",
          "scope",
          "targetBatches",
          "reason",
          "isActive",
          "showHolidayBriefing",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.type in ["VACATION", "HOLIDAY", "CLASS_SUSPENDED"]
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.scope in ["ALL_CLASSES", "SPECIFIC_BATCHES"]
        && (!("targetBatches" in request.resource.data) || request.resource.data.targetBatches is list)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.isActive is bool
        && request.resource.data.showHolidayBriefing is bool
        && request.resource.data.createdBy is string;
    }

    function validAcademicCalendarExceptionCreate() {
      return canEditTimetable()
        && validAcademicCalendarExceptionBase()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAcademicCalendarExceptionUpdate() {
      return canEditTimetable()
        && validAcademicCalendarExceptionBase()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function isDocSuperAdmin(docData) {
      return "role" in docData &&
        docData.role is string &&
        docData.role.lower() == "superadmin";
    }

    function isDocAdminOrSuperAdmin(docData) {
      return "role" in docData &&
        docData.role is string &&
        (docData.role.lower() == "admin" || docData.role.lower() == "superadmin");
    }

    function validManagerUserUpdate() {
      return canManageUsers()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "permissions",
          "approved",
          "updatedAt"
        ])
        && (!("approved" in request.resource.data) || request.resource.data.approved is bool)
        && (!("role" in request.resource.data) || request.resource.data.role is string)
        && (!("permissions" in request.resource.data) || request.resource.data.permissions is map)
        && (
          isSuperAdmin() ||
          (
            // Caller is a manager/admin, but NOT superadmin:
            // a) Cannot set role to superadmin
            (!("role" in request.resource.data) || request.resource.data.role.lower() != "superadmin")
            // b) Cannot modify a user document whose current role is superadmin
            && !isDocSuperAdmin(resource.data)
          )
        );
    }

    match /config/{doc} {
      allow read: if request.auth != null;
      allow read, write: if isLoggedIn() && isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isLoggedIn();

      allow create: if validOwnUserCreate(userId, request);

      allow update: if validManagerUserUpdate() 
        || validOwnUserUpdate(userId)
        // ── Fast-path: allow simple isOnline / favorites updates without heavy validation ──
        || (isLoggedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isOnline"])
            && request.resource.data.isOnline is bool)
        || (isLoggedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["favoritePdfIds"])
            && request.resource.data.favoritePdfIds is list)
        || (isLoggedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["favoriteSubjects"])
            && request.resource.data.favoriteSubjects is list);

      allow delete: if isLoggedIn() && (isSuperAdmin() || (canManageUsers() && !isDocAdminOrSuperAdmin(resource.data)));

      match /ai_chat_history/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /countdowns/{countdownId} {
        allow read: if isLoggedIn() && request.auth.uid == userId;
        allow create, update: if isLoggedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "assignmentId",
            "subject",
            "topic",
            "submissionDate",
            "type",
            "addedAt"
          ])
          && request.resource.data.assignmentId is string
          && request.resource.data.subject is string
          && request.resource.data.topic is string
          && request.resource.data.submissionDate is string
          && request.resource.data.type in ["assignment", "deadline", "exam", "quiz", "other"]
          && request.resource.data.addedAt == request.time;
        allow delete: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    match /student_id_lookup/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && studentId.matches("^[a-zA-Z0-9]{3,50}$")
        && request.resource.data.keys().hasOnly(["uid", "email"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /assignments/{assignmentId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /timetable/{day} {
      allow read: if isLoggedIn();
      allow write: if canEditTimetable();
    }
    
    match /timetable/{day}/periods/{periodId} {
      allow read: if isLoggedIn();
      allow create, delete: if canEditTimetable();
      allow update: if canEditTimetable() || validClassCancelPeriodUpdate();
    }

    match /bus_schedules/{scheduleId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if canEditTimetable();
    }

    match /academic_calendar_exceptions/{exceptionId} {
      allow read: if isLoggedIn();
      allow create: if validAcademicCalendarExceptionCreate();
      allow update: if validAcademicCalendarExceptionUpdate();
      allow delete: if canEditTimetable();
    }

    match /notices/{noticeId} {
      allow read: if isLoggedIn();
      allow create: if canPostNotice() || validResourceNoticeCreate() ||
        (canSendClassCancel() && request.resource.data.isCancel == true);
      allow delete: if canPostNotice();
      
      // Allow admins full update, but also allow any user to only increment readCount
      allow update: if canPostNotice() || (
        isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readCount"])
        && request.resource.data.readCount == resource.data.readCount + 1
      );

      // Read receipts subcollection — tracks who has seen each notice
      match /read_receipts/{receiptId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn()
          && receiptId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /notice_likes/{likeId} {
      allow read: if isLoggedIn();

      allow create: if isLoggedIn()
        && likeId == noticeLikeId(request.resource.data.noticeId)
        && request.resource.data.keys().hasOnly(["noticeId", "userId", "createdAt"])
        && request.resource.data.noticeId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if ownUserDoc();
      allow update: if false;
    }

    match /notice_comments/{commentId} {
      allow read: if isLoggedIn();

      allow create: if isLoggedIn()
        && request.resource.data.keys().hasOnly([
          "commentId",
          "noticeId",
          "userId",
          "userName",
          "userAvatar",
          "content",
          "parentCommentId",
          "likeCount",
          "replyCount",
          "createdAt",
          "updatedAt",
          "isDeleted"
        ])
        && request.resource.data.commentId == commentId
        && request.resource.data.noticeId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && request.resource.data.userAvatar is string
        && request.resource.data.userAvatar.size() <= 500
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && (
          request.resource.data.parentCommentId == null ||
          request.resource.data.parentCommentId is string
        )
        && request.resource.data.likeCount == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.isDeleted == false;

      allow update: if isLoggedIn() &&
        (
          (
            resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "content",
              "isDeleted",
              "updatedAt"
            ])
            && request.resource.data.isDeleted == true
            && request.resource.data.content == ""
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likeCount"])
            && request.resource.data.likeCount is int
            && request.resource.data.likeCount >= 0
            && (
              (
                request.resource.data.likeCount == resource.data.likeCount + 1
                && !exists(/databases/$(database)/documents/comment_likes/$(commentLikeId(commentId)))
                && existsAfter(/databases/$(database)/documents/comment_likes/$(commentLikeId(commentId)))
              )
              ||
              (
                request.resource.data.likeCount == resource.data.likeCount - 1
                && exists(/databases/$(database)/documents/comment_likes/$(commentLikeId(commentId)))
                && !existsAfter(/databases/$(database)/documents/comment_likes/$(commentLikeId(commentId)))
              )
            )
          )
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /comment_likes/{likeId} {
      allow read: if isLoggedIn();

      allow create: if isLoggedIn()
        && likeId == commentLikeId(request.resource.data.commentId)
        && request.resource.data.keys().hasOnly(["commentId", "userId", "createdAt"])
        && request.resource.data.commentId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if ownUserDoc();
      allow update: if false;
    }

    match /user_notice_reminders/{reminderDocId} {
      allow create: if isLoggedIn()
        && reminderDocId == reminderId(request.resource.data.noticeId)
        && request.resource.data.keys().hasOnly([
          "noticeId",
          "userId",
          "reminderAt",
          "createdAt",
          "isDone"
        ])
        && request.resource.data.noticeId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reminderAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.isDone == false;

      allow read, update, delete: if ownUserDoc();
    }

    match /user_notice_bookmarks/{bookmarkDocId} {
      allow create: if isLoggedIn()
        && bookmarkDocId == request.auth.uid + "_" + request.resource.data.noticeId
        && request.resource.data.keys().hasOnly([
          "userId",
          "noticeId",
          "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.noticeId is string
        && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);

      allow read, delete: if ownUserDoc();
      allow update: if false;
    }

    match /notice_shares/{shareId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /polls/{pollId} {
      function pollDoc() {
        return get(/databases/$(database)/documents/polls/$(pollId)).data;
      }

      function pollIsOpen() {
        return exists(/databases/$(database)/documents/polls/$(pollId)) &&
          pollDoc().isActive == true &&
          pollDoc().expiresAt > request.time;
      }

      function validVotePayload() {
        return request.resource.data.keys()
          .hasOnly(["option", "selectedOptions", "createdAt", "updatedAt"]) &&
          request.resource.data.option is string &&
          request.resource.data.selectedOptions is list &&
          request.resource.data.selectedOptions.size() > 0 &&
          request.resource.data.selectedOptions.size() <= 12 &&
          (pollDoc().allowMultipleAnswers == true ||
            request.resource.data.selectedOptions.size() == 1);
      }

      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();

      match /votes/{voteId} {
        allow read: if isLoggedIn();

        allow create: if isLoggedIn() &&
          request.auth.uid == voteId &&
          pollIsOpen() &&
          validVotePayload() &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if isLoggedIn() &&
          request.auth.uid == voteId &&
          pollIsOpen() &&
          validVotePayload() &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;

        allow delete: if isAdmin();
      }
    }

    match /pdfs/{pdfId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /library_files/{fileId} {
      // ── Zero-Trust Batch Document Privacy ──
      // When batch-private: accessible ONLY to approved users of that exact batch & department (NO superadmin or admin bypass)
      // When not batch-private: accessible to approved users/teachers/admins of that department (or superadmin)
      allow read: if isBatchPrivateDoc(resource.data)
        ? canReadBatchPrivateLibraryFile(resource.data)
        : canReadStandardLibraryFile(resource.data);
      allow create: if validLibraryCreate();
      allow update: if isAdmin() || validLibraryDownloadCountUpdate() || validLibrarySoftDeleteUpdate() || validLibraryBatchUpdate();
      allow delete: if isSuperAdmin();
    }

    match /results/{resultId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /seatplans/{planId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isAdmin() ||
        (isLoggedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isLoggedIn() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /attendance_sheets/{sheetId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /pending_notices/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /notification_queue/{docId} {
      allow read: if isAdmin() ||
        (isLoggedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isLoggedIn() &&
         resource.data.studentUid == request.auth.uid &&
         request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(["sent"]));
      allow delete: if isAdmin();
    }

    match /question_bank/{paperId} {
      // Any logged-in student can list/read non-deleted papers
      allow read: if isLoggedIn() && resource.data.isDeleted != true
         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true || isAdmin() || isTeacher());

      // Only users with upload permission can create a new question paper
      allow create: if validQbCreate();

      // Admins can do anything; uploaders can soft-delete their own doc;
      // any logged-in user can increment the download counter
      allow update: if isAdmin()
        || validQbSoftDelete()
        || validQbDownloadCountUpdate();

      // Hard delete restricted to superadmins only
      allow delete: if isSuperAdmin();
    }

    
    // ── Helper: check if caller's batch (and department) matches a group chat room ──
    function userBatchMatchesRoom(roomId) {
      return isLoggedIn()
        && userExists()
        && "batch" in getUser()
        && getUser().batch is string
        && getUser().batch != ""
        && (
          // Legacy format: group_batch_${batch}
          roomId == ("group_batch_" + getUser().batch) ||
          roomId == ("group_batch_" + getUser().batch.lower()) ||
          // Department-slugged format: group_${deptSlug}_batch_${batch}
          roomId.matches("^group_.*_batch_" + getUser().batch + "$") ||
          roomId.matches("^group_.*_batch_" + getUser().batch.lower() + "$") ||
          // Aliases for 14 / 2-1
          (getUser().batch == "14" && (
            roomId.matches(".*_batch_2_1$") ||
            roomId.matches(".*_batch_2-1$") ||
            roomId.matches(".*_batch_14$")
          )) ||
          (getUser().batch == "2-1" && (
            roomId.matches(".*_batch_14$") ||
            roomId.matches(".*_batch_2_1$")
          ))
        );
    }

    // ── Helper: check if caller is an assigned teacher/admin for a department-scoped room ──
    function isStaffForRoomDepartment(roomId) {
      return isLoggedIn() && (
        isSuperAdmin() ||
        (
          (isAdmin() || isTeacher()) &&
          userExists() && (
            (
              "departmentId" in getUser() && getUser().departmentId is string && getUser().departmentId != "" &&
              roomId.matches("^group_" + getUser().departmentId.lower() + "_.*")
            ) ||
            (
              "department" in getUser() && getUser().department is string && getUser().department != "" &&
              getUser().department.matches("^[a-zA-Z0-9_-]+$") &&
              roomId.matches("^group_" + getUser().department.lower() + "_.*")
            )
          )
        )
      );
    }

    // ── Helper: check if user's department matches a department-scoped room ──
    function userDeptMatchesRoom(roomId) {
      return userExists() && (
        (
          "departmentId" in getUser() && getUser().departmentId is string && getUser().departmentId != "" &&
          roomId.matches("^group_" + getUser().departmentId.lower() + "_.*")
        ) ||
        (
          "department" in getUser() && getUser().department is string && getUser().department != "" &&
          getUser().department.matches("^[a-zA-Z0-9_-]+$") &&
          roomId.matches("^group_" + getUser().department.lower() + "_.*")
        )
      );
    }

    // ── Helper: check if user is a participant in a direct message (DM) room ──
    function isDmParticipant(roomId) {
      return roomId.matches("^dm_" + request.auth.uid + "_[a-zA-Z0-9_-]+$")
        || roomId.matches("^dm_[a-zA-Z0-9_-]+_" + request.auth.uid + "$")
        || (resource != null && "member1Id" in resource.data && (resource.data.member1Id == request.auth.uid || resource.data.member2Id == request.auth.uid));
    }

    function canAccessChatRoom(roomId) {
      // Direct messages: strictly limited to the two participants (prevents DM snoop)
      // Group rooms: scoped by admin/superadmin, user batch + department, or assigned staff
      return isLoggedIn() && (
        (roomId.matches("^dm_.*") && isDmParticipant(roomId)) ||
        (roomId.matches("^group_.*") && (
          isSuperAdmin() ||
          isAdmin() ||
          // a) It is group_main (accessible to all logged-in students/teachers)
          (roomId == "group_main") ||
          // b) Batch-matched rooms (legacy group_batch_${batch} or department-slugged group_.*_batch_${batch})
          userBatchMatchesRoom(roomId) ||
          // c) Caller is an assigned teacher/admin for that department
          isStaffForRoomDepartment(roomId) ||
          // d) Department main rooms (e.g. group_${deptSlug}_main) for students of that department
          (roomId.matches("^group_[a-zA-Z0-9_-]+_main$") && userDeptMatchesRoom(roomId))
        ))
      );
    }

    match /chat_rooms/{roomId} {
      allow read: if canAccessChatRoom(roomId);
      allow create: if canAccessChatRoom(roomId);
      allow update: if canAccessChatRoom(roomId) &&
        (!("id" in request.resource.data) || request.resource.data.id == roomId);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if canAccessChatRoom(roomId);
        allow create: if canAccessChatRoom(roomId)
          && request.resource.data.senderId == request.auth.uid
          && (!("text" in request.resource.data) || request.resource.data.text.size() <= 5000)
          && (!("imageUrl" in request.resource.data) || request.resource.data.imageUrl.size() <= 1000);
          
        allow update: if canAccessChatRoom(roomId)
          && request.resource.data.senderId == resource.data.senderId
          && (!("text" in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.senderId == request.auth.uid)
          && (!("text" in request.resource.data) || request.resource.data.text.size() <= 5000)
          && (!("reactions" in request.resource.data.diff(resource.data).affectedKeys()) || true)
          && (!("seenBy" in request.resource.data.diff(resource.data).affectedKeys()) || true)
          && (!("isPinned" in request.resource.data.diff(resource.data).affectedKeys()) || true)
          && (!("isDeleted" in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.senderId == request.auth.uid);
          
        allow delete: if isAdmin() || resource.data.senderId == request.auth.uid;
      }
    }

    
    match /subjects/{subjectId} {
      allow read: if isLoggedIn();
      allow create: if canUploadPdf();
      allow update: if canUploadPdf();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ── Lost & Found Items ────────────────────────────────────────────────────
    match /lost_and_found/{itemId} {
      // 1. Any logged-in user can read lost and found posts
      allow read: if isLoggedIn();

      // 2. Any logged-in user can report an item as long as reporterId matches their UID
      allow create: if isLoggedIn()
        && request.resource.data.reporterId == request.auth.uid;

      // 3. Post creator or admins/superadmins can update the item (e.g. mark as resolved), or any user for social interactions
      allow update: if isLoggedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'viewers', 'loveCount', 'loveReactors', 'sharesCount', 'reportedCount', 'reportedBy'
        ])
      );

      // 4. Post creator, admins/superadmins, unassigned items, resolved items, or any logged-in user for expired items (> 15 days) can delete
      allow delete: if isLoggedIn() && (
        !("reporterId" in resource.data) ||
        resource.data.reporterId == "" ||
        resource.data.reporterId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin() ||
        resource.data.isResolved == true ||
        resource.data.timestamp < request.time - duration.value(15, 'd')
      );
    }

    // ── Urgent Blood Requests ────────────────────────────────────────────────
    match /blood_requests/{requestId} {
      // 1. Any logged-in user can read active blood requests
      allow read: if isLoggedIn();

      // 2. Any logged-in user can create a blood request for themselves or a patient
      allow create: if isLoggedIn()
        && request.resource.data.requesterId == request.auth.uid;

      // 3. Request creator, admins, or superadmins can update, or any user for social interactions / donation confirmation
      allow update: if isLoggedIn() && (
        resource.data.requesterId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'viewers', 'loveCount', 'loveReactors', 'sharesCount',
          'reportedCount', 'reportedBy', 'reportReason', 'isFulfilled', 'isDonated', 'donatedAt', 'donatedBy'
        ])
      );

      // 4. Request creator, admins, superadmins, fulfilled requests, or expired requests (> 15 days) can delete
      allow delete: if isLoggedIn() && (
        resource.data.requesterId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin() ||
        resource.data.isFulfilled == true ||
        resource.data.timestamp < request.time - duration.value(15, 'd')
      );
    }

    // ── In-App Notifications ────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // 1. Logged in users can read notifications
      allow read: if isLoggedIn();

      // 2. Any logged-in user can dispatch a notification (to admin or post author)
      allow create: if isLoggedIn();

      // 3. Logged-in users can mark notifications as read (updating isRead, readBy), or admins can update
      allow update: if isLoggedIn() && (
        isAdmin() ||
        isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readBy'])
      );

      // 4. Only admins or superadmins can delete notifications
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ── Campus Clubs, Events & Registrations ─────────────────────────────────

    function isClubExecutiveData(clubData) {
      return ("presidentId" in clubData && clubData.presidentId == request.auth.uid) ||
             ("gsId" in clubData && clubData.gsId == request.auth.uid) ||
             ("agsId" in clubData && clubData.agsId == request.auth.uid);
    }

    function isClubExecutive(clubId) {
      return exists(/databases/$(database)/documents/campus_clubs/$(clubId)) &&
        isClubExecutiveData(get(/databases/$(database)/documents/campus_clubs/$(clubId)).data);
    }

    function isEventExpired() {
      return ("eventDateMillis" in resource.data &&
              resource.data.eventDateMillis is number &&
              resource.data.eventDateMillis > 0 &&
              resource.data.eventDateMillis < request.time.toMillis());
    }

    match /campus_clubs/{clubId} {
      // 1. Any logged-in user can view campus clubs
      allow read: if isLoggedIn();

      // 2. Only Superadmin can register new clubs
      allow create: if isSuperAdmin();

      // 3. Update: users joining/leaving (memberUids), superadmin, or club executives (President, GS, AGS)
      allow update: if isLoggedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) ||
        isSuperAdmin() ||
        isClubExecutiveData(resource.data)
      );

      // 4. Delete: Superadmin or club president
      allow delete: if isSuperAdmin() || (
        isLoggedIn() &&
        "presidentId" in resource.data &&
        resource.data.presidentId == request.auth.uid
      );
    }

    match /campus_events/{eventId} {
      // 1. Any logged-in user can view campus events
      allow read: if isLoggedIn();

      // 2. Create: Superadmin, event creator, or organizing club executive
      allow create: if isLoggedIn() && (
        isSuperAdmin() ||
        ("creatorId" in request.resource.data && request.resource.data.creatorId == request.auth.uid) ||
        ("clubId" in request.resource.data && isClubExecutive(request.resource.data.clubId))
      );

      // 3. Update: users registering (registeredUserIds), superadmin, event creator, or organizing club executive
      allow update: if isLoggedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredUserIds']) ||
        isSuperAdmin() ||
        ("creatorId" in resource.data && resource.data.creatorId == request.auth.uid) ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId))
      );

      // 4. Delete: Superadmin, creator, organizing club executive, or expired events
      allow delete: if isLoggedIn() && (
        isSuperAdmin() ||
        ("creatorId" in resource.data && resource.data.creatorId == request.auth.uid) ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId)) ||
        isEventExpired()
      );
    }

    match /event_registrations/{registrationId} {
      // 1. Read: own registration, superadmin, or executive of the organizing club
      allow read: if isLoggedIn() && (
        ("userId" in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin() ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId))
      );

      // 2. Create: student submitting own registration request
      allow create: if isLoggedIn() &&
        "userId" in request.resource.data &&
        request.resource.data.userId == request.auth.uid;

      // 3. Update: superadmin or club executive confirming/approving registrations
      allow update: if isLoggedIn() && (
        isSuperAdmin() ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId))
      );

      // 4. Delete: student cancelling own registration or superadmin
      allow delete: if isLoggedIn() && (
        ("userId" in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    match /club_membership_requests/{requestId} {
      // 1. Read: own request, superadmin, or executive of the target club
      allow read: if isLoggedIn() && (
        ("userId" in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin() ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId))
      );

      // 2. Create: student submitting own membership request
      allow create: if isLoggedIn() &&
        "userId" in request.resource.data &&
        request.resource.data.userId == request.auth.uid;

      // 3. Update: superadmin or club executive approving requests
      allow update: if isLoggedIn() && (
        isSuperAdmin() ||
        ("clubId" in resource.data && isClubExecutive(resource.data.clubId))
      );

      // 4. Delete: student cancelling own request or superadmin
      allow delete: if isLoggedIn() && (
        ("userId" in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    match /important_contacts/{contactId} {
      // 1. Read: All logged-in users
      allow read: if isLoggedIn();

      // 2. Create: Super Admin only
      allow create: if isSuperAdmin();

      // 3. Update: Super Admin only
      allow update: if isSuperAdmin();

      // 4. Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }

    // ── CampusFeed & Community Square ─────────────────────────────────────────
    match /campus_feed/{postId} {
      // 1. Read: Any logged-in user can read feed posts
      allow read: if isLoggedIn();

      // 2. Create: Restricted during Closed Beta to privileged roles (Admin, Teacher, Club Admin, CR)
      allow create: if isLoggedIn() &&
        (isAdmin() || getRole() in ['teacher', 'club_admin', 'cr']) &&
        request.resource.data.authorId == request.auth.uid;

      // 3. Update:
      //    - Post author or admin can update post content (authorId immutable)
      //    - Any logged-in user can interact (reactions/loves, poll votes, petition signatures, views, shares, reports, and commentCount)
      allow update: if isLoggedIn() && (
        ((isAdmin() || resource.data.authorId == request.auth.uid) &&
         request.resource.data.authorId == resource.data.authorId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'loveCount', 'loveReactors',
          'pollVotes',
          'petitionSigners',
          'viewCount', 'viewers', 'shareCount',
          'reportCount', 'reporters', 'isQuarantined',
          'commentCount', 'hotScore'
        ])
      );

      // 4. Delete: Post author or Admin
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.authorId == request.auth.uid);

      // Subcollection: comments
      match /comments/{commentId} {
        // Read: Any logged-in user
        allow read: if isLoggedIn();

        // Create: Any logged-in user with authorId matching their auth UID
        allow create: if isLoggedIn() && request.resource.data.authorId == request.auth.uid;

        // Update: Comment author or Admin
        allow update: if isAdmin() || (isLoggedIn() && resource.data.authorId == request.auth.uid);

        // Delete: Comment author or Admin
        allow delete: if isAdmin() || (isLoggedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /campus_feed_waitlist/{uid} {
      // Owner only: Read and write restricted to the authenticated user owning the document
      allow read, write: if isLoggedIn() && request.auth.uid == uid;
    }

    match /campus_feed_suggestions/{id} {
      // Create: Logged-in user submitting idea with their own UID
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;

      // Read, Update, Delete: Admin only
      allow read, update, delete: if isAdmin();
    }

    match /campus_feed_bookmarks/{id} {
      // Owner only: Read, write, or delete own bookmarks
      allow read, write: if isLoggedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}

