<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle drop shadow layer around circle -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1.5dp"
        android:bottom="0.5dp">
        <shape android:shape="oval">
            <size android:width="27dp" android:height="27dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>
    <!-- Crisp White Circular Thumb -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <size android:width="27dp" android:height="27dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="0.5dp" android:color="#10000000" />
        </shape>
    </item>
</layer-list>
