<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <!-- iOS-style card scale expansion with subtle overshoot bounce -->
    <scale
        android:duration="320"
        android:fromXScale="0.90"
        android:toXScale="1.0"
        android:fromYScale="0.90"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:interpolator="@anim/mac_overshoot_interpolator" />

    <!-- Subtle vertical reveal translation -->
    <translate
        android:duration="320"
        android:fromYDelta="28dp"
        android:toYDelta="0"
        android:interpolator="@android:interpolator/decelerate_cubic" />

    <!-- Fast alpha fade-in -->
    <alpha
        android:duration="220"
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:interpolator="@android:interpolator/linear" />
</set>
