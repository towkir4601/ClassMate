<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivFriendProfile"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_default_avatar"
            app:civ_border_color="@color/wa_divider"
            app:civ_border_width="1dp" />

        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_online_dot_border"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFriendName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wa_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFriendId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wa_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnMessage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_message"
            android:contentDescription="Chat"
            android:padding="8dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_call"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnWhatsapp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_whatsapp"
            android:contentDescription="WhatsApp"
            android:padding="8dp"
            android:src="@drawable/ic_whatsapp"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
