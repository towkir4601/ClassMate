<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <!-- Background squircle -->
    <View
        android:id="@+id/vCellBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_cell_default" />

    <!-- Selection glow border -->
    <View
        android:id="@+id/vSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_day_selected"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Today circle ring -->
    <View
        android:id="@+id/vTodayRing"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_calendar_day_today"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Day number text -->
    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/cm_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="19" />

    <!-- Campus event indicator dot (amber/gold) -->
    <View
        android:id="@+id/dotEvent"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_calendar_day_today"
        android:backgroundTint="@color/cal_event_amber"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
