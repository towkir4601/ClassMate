<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lost_found_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_handle" />

    <!-- Header Title with Close '✕' Button (Matching Pic 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report Lost or Found Item"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#2E3642" />

    <!-- Type Switcher (FOUND vs LOST) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_lost_found_input"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabFound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_accent_pill"
            android:backgroundTint="#2E7D32"
            android:gravity="center"
            android:text="✔  FOUND ITEM"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabLost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍  LOST ITEM"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Field 1: Item Name / Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item Name / Description"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_lost_found_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_document_sheet"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etReportTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="e.g. Casio Calculator FX-991EX, ID Card..."
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Field 2: Location Spotted / Lost -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location Spotted / Lost"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_lost_found_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_location_pin"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etReportLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="e.g. Library 2nd Floor, Cafeteria..."
            android:inputType="textCapWords"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Field 3: Your Contact Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Contact Number"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_lost_found_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_phone_receiver"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etReportPhone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="e.g. 01700-123456"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Publish Button (Matching Pic 2) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPublishReport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#6366F1"
        android:text="Publish Report"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_upload_arrow"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

</LinearLayout>
