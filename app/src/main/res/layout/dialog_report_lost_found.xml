<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Title with Close '✕' Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_squircle_dark"
            android:padding="5dp"
            android:src="@drawable/ic_location_pin"
            app:tint="#6366F1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Lost / Found Item"
                android:textColor="@color/cm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broadcast lost belongings to GSTU campus"
                android:textColor="@color/cm_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/cm_text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@color/cm_divider" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Type Switcher (FOUND vs LOST) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_lost_found_input"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabFound"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_accent_pill"
                    android:backgroundTint="#166534"
                    android:gravity="center"
                    android:text="✔  FOUND ITEM"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabLost"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔍  LOST ITEM"
                    android:textColor="@color/cm_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Field 1: Item Name / Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Name &amp; Description *"
                android:textColor="@color/cm_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
        android:background="@drawable/bg_dialog_input_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_document_sheet"
            app:tint="@color/cm_text_muted" />

        <EditText
            android:id="@+id/etReportTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="e.g. Casio FX-991EX, Student ID, Wallet"
            android:inputType="textCapSentences"
            android:textColor="@color/cm_text_primary"
            android:textColorHint="@color/cm_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Field 2: Location Spotted / Lost -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location Spotted or Lost *"
        android:textColor="@color/cm_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_dialog_input_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/cm_text_muted" />

        <EditText
            android:id="@+id/etReportLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="e.g. Central Library 2nd floor, Cafeteria"
            android:inputType="textCapWords"
            android:textColor="@color/cm_text_primary"
            android:textColorHint="@color/cm_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Field 3: Your Contact Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Phone Number *"
        android:textColor="@color/cm_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_input_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_phone_receiver"
            app:tint="@color/cm_text_muted" />

        <EditText
            android:id="@+id/etReportPhone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="017xxxxxxxx or Front Desk"
            android:inputType="phone"
            android:textColor="@color/cm_text_primary"
            android:textColorHint="@color/cm_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Field 4: Optional Item Photo with Sub-100KB Auto-Compression -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item Photo (Optional - Auto-compressed &lt;100KB)"
        android:textColor="@color/cm_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Button to pick photo -->
    <LinearLayout
        android:id="@+id/btnSelectPhoto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_lost_found_input"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/bg_wa_attach_camera"
            app:tint="#818CF8" />

        <TextView
            android:id="@+id/tvSelectPhotoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+ Add Item Photo (Auto-compressed &lt;100KB)"
            android:textColor="@color/cm_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview Container of selected photo -->
    <FrameLayout
        android:id="@+id/layoutPhotoPreview"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/cm_card_alt"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cm_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivSelectedPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Selected item preview" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Compressed File Size Badge -->
        <TextView
            android:id="@+id/tvCompressedSizeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_accent_pill"
            android:backgroundTint="#0F172A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="📸 76 KB"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Remove Photo Button -->
        <ImageButton
            android:id="@+id/btnRemoveSelectedPhoto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_whatsapp_fab"
            android:backgroundTint="#EF4444"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF"
            android:contentDescription="Remove photo" />

        <!-- Compressing / Uploading Progress Indicator -->
        <ProgressBar
            android:id="@+id/pbPhotoCompressing"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="#818CF8"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Info note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_badge_accent_pill"
        android:backgroundTint="@color/cm_card_alt"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bell_outline"
            app:tint="#A5B4FC" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Your report goes live instantly and will automatically expire and be deleted after 15 days."
            android:textColor="@color/cm_text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Publish Button (Matching Pic 2) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPublishReport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#6366F1"
        android:text="Publish to Lost &amp; Found"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_upload_arrow"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

</LinearLayout>
