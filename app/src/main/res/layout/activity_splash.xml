<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_bg">

    <!-- Campus Academic Building Photo Background -->
    <ImageView
        android:id="@+id/ivCampusBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="GSTU Campus"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_gstu_campus" />

    <!-- Cinematic Vignette Gradient Overlay -->
    <View
        android:id="@+id/vVignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient_overlay" />

    <!-- Foreground Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Top Header: Official University Name -->
        <TextView
            android:id="@+id/tvUniversityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Gopalganj Science and Technology University"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:alpha="1" />

        <!-- Center Brand Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- App Logo with Halo Glow Backing -->
            <FrameLayout
                android:id="@+id/flLogoContainer"
                android:layout_width="160dp"
                android:layout_height="160dp">

                <ImageView
                    android:id="@+id/ivLogoGlow"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_logo_halo_glow" />

                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:contentDescription="GSTU Go Logo"
                    android:src="@drawable/logo_gstu_go" />
            </FrameLayout>

            <!-- Brand Title -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:text="GSTU Go"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:alpha="1" />

            <!-- Bengali Subtitle Badge -->
            <TextView
                android:id="@+id/tvAppSubtitleBn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.02"
                android:text="বিশ্ববিদ্যালয় ক্যাম্পাস অ্যাপ"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:alpha="1" />

        </LinearLayout>

        <!-- Footer Tagline & Loading Indicator -->
        <LinearLayout
            android:id="@+id/llFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:text="Empowering Campus Life"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                tools:alpha="1" />

            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/cm_primary" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
