<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_squircle_dark"
            android:padding="5dp"
            android:src="@drawable/ic_notice"
            app:tint="#0284C7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Class Notice"
                android:textColor="@color/cm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broadcasted to your department &amp; batch"
                android:textColor="@color/cm_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/cm_text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/cm_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category Selector Pills -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTICE TYPE"
                android:textColor="@color/cm_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillTypeRoutine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_accent_pill"
                        android:backgroundTint="#0284C7"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="🔄 Routine Update"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pillTypeCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_lost_found_pill_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="🚫 Class Cancel"
                        android:textColor="@color/cm_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pillTypeMakeup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_lost_found_pill_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="⏱️ Extra / Makeup"
                        android:textColor="@color/cm_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pillTypeResource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_lost_found_pill_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="📂 Study Resource"
                        android:textColor="@color/cm_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Notice Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TITLE *"
                android:textColor="@color/cm_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="e.g. Algorithm Lab shifted to 11:30 AM"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cm_text_primary"
                android:textColorHint="@color/cm_text_muted"
                android:textSize="14sp" />

            <!-- Notice Description / Message -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETAILS / INSTRUCTIONS *"
                android:textColor="@color/cm_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeBody"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:gravity="top|start"
                android:hint="Explain details (room number, topic, or instructions for the batch)..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/cm_text_primary"
                android:textColorHint="@color/cm_text_muted"
                android:textSize="13.5sp" />

            <!-- Optional Resource Link / Drive URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESOURCE / DRIVE URL (OPTIONAL)"
                android:textColor="@color/cm_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeResourceUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="https://drive.google.com/... or slides link"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cm_text_primary"
                android:textColorHint="@color/cm_text_muted"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:background="@color/cm_divider" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/cm_text_muted"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishNotice"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#0284C7"
            android:text="Broadcast Notice"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
