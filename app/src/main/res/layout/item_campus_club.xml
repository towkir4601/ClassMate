<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardClubRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#161B22"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#2E3642"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Circle Icon Container -->
        <FrameLayout
            android:id="@+id/flClubIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_fill"
            android:backgroundTint="#1E293B">

            <ImageView
                android:id="@+id/ivClubIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_code_terminal"
                app:tint="#38BDF8" />
        </FrameLayout>

        <!-- Details Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClubName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GSTU Computer Club (GSTUCC)"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClubSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Code, Compete, Innovate"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Real Member Count -->
                <TextView
                    android:id="@+id/tvClubMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Members"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- User Role Badge if Member or Executive -->
                <TextView
                    android:id="@+id/tvClubRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_accent_pill"
                    android:backgroundTint="#312E81"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="Member"
                    android:textColor="#C7D2FE"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Superadmin / President Delete Club Button -->
        <ImageButton
            android:id="@+id/btnDeleteClub"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Club"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="#F87171" />

        <!-- Right Arrow -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
