<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <EditText
        android:id="@+id/etExtraOption"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_lost_found_input"
        android:hint="Option"
        android:textColor="@color/cm_text_primary"
        android:textColorHint="@color/cm_text_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/btnRemoveExtraOption"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:tint="@color/cm_text_muted"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove option" />
</LinearLayout>
