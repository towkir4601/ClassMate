<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Course Name (e.g. Data Structures)"
        android:inputType="textCapWords"
        android:padding="12dp"
        android:background="@drawable/bg_chat_input"
        android:textColor="@color/cm_text_primary"
        android:textColorHint="@color/cm_text_muted"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etSubjectCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Course Code"
        android:inputType="textCapCharacters"
        android:padding="12dp"
        android:background="@drawable/bg_chat_input"
        android:textColor="@color/cm_text_primary"
        android:textColorHint="@color/cm_text_muted"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etSubjectBatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target Batch (e.g. 14) - Optional"
        android:inputType="text"
        android:padding="12dp"
        android:background="@drawable/bg_chat_input"
        android:textColor="@color/cm_text_primary"
        android:textColorHint="@color/cm_text_muted"
        android:layout_marginBottom="12dp"/>
</LinearLayout>
