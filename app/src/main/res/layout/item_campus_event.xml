<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEventRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#161B22"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#2E3642"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Status Badge, Category & Executive Delete Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEventStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_accent_pill"
                android:backgroundTint="#132B20"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="REGISTRATION OPEN"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEventCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_accent_pill"
                android:backgroundTint="#1E293B"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Tech"
                android:textColor="#C7D2FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Executive / Admin Delete Event Button -->
            <ImageButton
                android:id="@+id/btnDeleteEvent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Event"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="#F87171" />
        </LinearLayout>

        <!-- High-contrast crisp White Title -->
        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Intra-University Programming Contest 2026"
            android:textColor="#FFFFFF"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <!-- Club / Organizer Name in Slate 300 -->
        <TextView
            android:id="@+id/tvEventOrganizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="GSTU Computer Club"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <!-- Date & Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_calendar"
                app:tint="#818CF8" />

            <TextView
                android:id="@+id/tvEventDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Oct 14, 2026 • 09:00 AM"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Location Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location_pin"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvEventLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="CSE Software Labs 1 &amp; 2"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Action Button (Register / Status / Details) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventAction"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#6366F1"
            android:text="✔  Register for Event"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
