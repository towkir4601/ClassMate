<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161B22"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Register New Club"
            android:textColor="#FFFFFF"
            android:textSize="18.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseCreateClub"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Register an official student organization and set leadership roles (President, GS, AGS). Only Superadmin can create clubs."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#2E3642" />

    <!-- Scrollable Form with Button INSIDE so it never gets clipped -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Club Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club / Organization Name *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewClubName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="e.g. GSTU Cyber Security Club"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Subtitle / Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tagline / Motto *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewClubSubtitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="e.g. Defend, Protect, Secure"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Category *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewClubCategory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="e.g. Technology, Hardware, Debate, Sports"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Executive Leadership Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Executive Leadership"
                android:textColor="#818CF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- President -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="President Name *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubPresidentName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="President Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- General Secretary (GS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="General Secretary (GS) Name *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubGsName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="GS Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Assistant General Secretary (AGS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Assistant General Secretary (AGS) Name *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubAgsName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="AGS Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Club Description"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewClubDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:gravity="top|start"
                android:hint="About club activities, regular events, mission..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <!-- Contact Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Contact Email"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewClubEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dialog_input_dark"
                android:hint="e.g. cyberclub@campus.edu"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <!-- Create Club Button - Placed inside scroll so it is 100% visible on all devices -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateClubSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#4F46E5"
                android:text="Create Club"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="#FFFFFF" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
