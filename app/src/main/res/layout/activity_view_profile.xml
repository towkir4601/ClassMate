<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cm_surface"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/cm_text_primary" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Profile"
                android:textColor="@color/cm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnShareProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share Profile"
                android:src="@drawable/ic_share"
                app:tint="@color/cm_text_primary" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="48dp">

            <!-- Hero Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cm_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cm_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                        <!-- Profile Avatar -->
                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <View
                                android:id="@+id/profileBorder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_profile_picture_border" />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/ivAvatar"
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_default_avatar" />

                            <TextView
                                android:id="@+id/tvAvatarFallback"
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_avatar"
                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="S" />
                        </FrameLayout>

                        <!-- Full Name with Verified Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvFullName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cm_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Shuaib Uddowla" />

                            <ImageView
                                android:id="@+id/ivVerifiedBadge"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_verified_badge"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <!-- Role Badge -->
                        <TextView
                            android:id="@+id/tvRoleBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_accent_pill"
                            android:backgroundTint="@color/cm_primary"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="3dp"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            tools:text="STUDENT" />

                        <!-- Department & Batch -->
                        <TextView
                            android:id="@+id/tvDepartmentBatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="@color/cm_text_secondary"
                            android:textSize="13.5sp"
                            tools:text="Computer Science and Engineering • Batch 14" />

                        <!-- Student ID / Teacher Code -->
                        <TextView
                            android:id="@+id/tvStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/cm_text_muted"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            tools:text="ID: 22CSE001" />

                        <!-- Quick Action Buttons -->
                        <LinearLayout
                            android:id="@+id/layoutSelfActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditProfile"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/cm_primary"
                                android:text="Edit Profile"
                                android:textAllCaps="false"
                                android:textColor="@color/cm_on_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_edit"
                                app:iconGravity="textStart"
                                app:iconTint="@color/cm_on_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnShareCard"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="Share Card"
                                android:textAllCaps="false"
                                android:textColor="@color/cm_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_share"
                                app:iconGravity="textStart"
                                app:iconTint="@color/cm_primary"
                                app:strokeColor="@color/cm_primary"
                                app:strokeWidth="1.2dp" />
                        </LinearLayout>

                        <!-- Peer Actions (When viewing other students/teachers) -->
                        <LinearLayout
                            android:id="@+id/layoutOtherActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChat"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1.2"
                                android:backgroundTint="@color/cm_primary"
                                android:text="Message"
                                android:textAllCaps="false"
                                android:textColor="@color/cm_on_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_chat"
                                app:iconGravity="textStart"
                                app:iconTint="@color/cm_on_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCall"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                android:text="Call"
                                android:textAllCaps="false"
                                android:textColor="@color/cm_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_phone"
                                app:iconGravity="textStart"
                                app:iconTint="@color/cm_text_primary"
                                app:strokeColor="@color/cm_border"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWhatsApp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:text="WhatsApp"
                                android:textAllCaps="false"
                                android:textColor="#16A34A"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_whatsapp"
                                app:iconGravity="textStart"
                                app:iconTint="#16A34A"
                                app:strokeColor="#16A34A"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatPostsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Campus Posts"
                        android:textColor="@color/cm_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/cm_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatDeptCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cm_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="CSE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Department"
                        android:textColor="@color/cm_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/cm_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatBatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="14th" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Batch"
                        android:textColor="@color/cm_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Segmented Tabs for Posts vs Info (Posts first) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dept_search_input"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnTabPosts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dept_acronym_pill"
                    android:gravity="center"
                    android:text="Posts &amp; Activities"
                    android:textColor="@color/cm_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTabInfo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="About &amp; Info"
                    android:textColor="@color/cm_text_muted"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TAB: Information View (2nd tab) -->
            <LinearLayout
                android:id="@+id/layoutTabInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Academic Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/cm_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/cm_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="ACADEMIC INFORMATION"
                            android:textColor="@color/cm_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <include
                            android:id="@+id/rowUniversity"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowDepartment"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowStudentId"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowBatch"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowSemester"
                            layout="@layout/item_profile_detail" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Contact & Personal Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/cm_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/cm_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="CONTACT &amp; PERSONAL"
                            android:textColor="@color/cm_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <include
                            android:id="@+id/rowEmail"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowPhone"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowWhatsApp"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowBloodGroup"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowDistrict"
                            layout="@layout/item_profile_detail" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Address Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/cm_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/cm_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="RESIDENTIAL ADDRESS"
                            android:textColor="@color/cm_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <include
                            android:id="@+id/rowPresentAddress"
                            layout="@layout/item_profile_detail" />

                        <include
                            android:id="@+id/rowPermanentAddress"
                            layout="@layout/item_profile_detail" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- TAB: Posts & Activity View (1st tab) -->
            <LinearLayout
                android:id="@+id/layoutTabPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Loading Spinner for Posts -->
                <ProgressBar
                    android:id="@+id/pbPostsLoading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="32dp"
                    android:indeterminateTint="@color/cm_primary" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutNoPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/cm_text_disabled" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No campus drops yet"
                        android:textColor="@color/cm_text_secondary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNoPostsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Posts shared on the Campus Feed will appear here"
                        android:textColor="@color/cm_text_muted"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenCampusFeed"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/cm_primary"
                        android:text="Explore Campus Feed"
                        android:textAllCaps="false"
                        android:textColor="@color/cm_on_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- User's Posts List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUserPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_campus_feed_post" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
