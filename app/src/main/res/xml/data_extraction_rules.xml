<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for GSTU Go (ClassMate) - Android 12+ -->
<data-extraction-rules>
    <!-- Prevent cloud backups of app data -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <!-- Prevent device-to-device transfer of app private data -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
